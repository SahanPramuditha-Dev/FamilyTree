rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/trees/{treeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /families/{familyId}/members/{memberUserId} {
      allow read, write: if request.auth != null && request.auth.uid == memberUserId;
    }

    match /families/{familyId}/invitations/{inviteId} {
      allow read, write: if request.auth != null;
    }

    match /publicTrees/{familyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
